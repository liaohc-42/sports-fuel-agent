# ============================================================
# 🔑 大模型配置（开发者后端）—— 醒目入口
# ============================================================
# 支持三种后端，任选其一；都不填 = 自动使用本地规则引擎（离线可用）。
#
#   GLM（智谱，免费）：  https://open.bigmodel.cn/  → API Keys
#   DeepSeek：           https://platform.deepseek.com/  → API Keys
#   Ollama（本地跑）：    https://ollama.com  安装后 `ollama run qwen2.5`
#
# ⚠️ 安全：本文件被 .gitignore 忽略，不会上传；Key 只配在这里，不要写进前端。
# ============================================================

# ---------- 方案一：智谱 GLM-4-Flash（免费） ----------
# 填了 GLM_API_KEY 后：文本用 glm-4-flash；图片识别自动用 glm-4v-flash（视觉，免费）
GLM_API_KEY=
GLM_MODEL=glm-4-flash
# 可选：视觉模型（默认 glm-4v-flash）
# GLM_VISION_MODEL=glm-4v-flash

# ---------- 方案二：DeepSeek（OpenAI 兼容） ----------
# 注意：DeepSeek Key 形如 sk-xxx
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---------- 方案三：Ollama 本地大模型（不联网、不花钱） ----------
# 先安装 Ollama 并 `ollama run qwen2.5`，再填下面两行
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5
# 图片识别用视觉模型（如 llava / qwen2.5-vl）
# OLLAMA_VISION_MODEL=llava

# 可选：强制指定后端（glm / deepseek / ollama / local）
# PROVIDER=

# 可选：/api/admin/set-key 的运行态令牌
ADMIN_TOKEN=
